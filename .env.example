# Database — use a hosted PostgreSQL provider (Neon, Supabase, or Railway)
DATABASE_URL="postgresql://user:password@host:5432/allo-inventory?sslmode=require"

# Redis — use Upstash Redis (https://upstash.com)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Reservation TTL in minutes (default: 10)
# Set to 2 for demo purposes during the debrief call
RESERVATION_TTL_MINUTES=10

# Cron Secret — used to authenticate the cron job endpoint
# On Vercel Pro, this is injected automatically.
# On the free tier, set it manually.
CRON_SECRET="your-cron-secret-here"
